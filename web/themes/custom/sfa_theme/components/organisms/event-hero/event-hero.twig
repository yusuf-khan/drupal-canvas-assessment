<section {{ attributes.addClass('sfa-event-hero', 'sfa-surface--' ~ background|default('cream')) }}>
  {% if photo.src %}
    <div class="sfa-event-hero__media" aria-hidden="true">
      {% include 'canvas:image' with photo|merge({alt: '', loading: 'eager', attributes: create_attribute({alt: ''})}) only %}
    </div>
  {% endif %}
  <div class="sfa-container">
    <div class="sfa-event-hero__copy">
      {% include 'sfa_theme:eyebrow' with {text: eyebrow|default(''), attributes: create_attribute({class: ['sfa-event-hero__eyebrow']})} only %}
      {% include 'sfa_theme:title' with {formatted: formatted_heading|default(''), level: 'h1', attributes: create_attribute({class: ['sfa-event-hero__title']})} only %}
      {% include 'sfa_theme:prose' with {formatted: formatted_summary|default(''), attributes: create_attribute({class: ['sfa-event-hero__summary']})} only %}
      {% if event_date or venue or city %}
        <div class="sfa-event-hero__details">
          {% include 'sfa_theme:event-detail' with {glyph: 'calendar-days', text: event_date|default('')} only %}
          {% include 'sfa_theme:event-detail' with {glyph: 'location-dot', text: venue|default(''), second_line: city|default('')} only %}
        </div>
      {% endif %}
      {% set desktop_buttons %}{% block desktop_actions %}{% endblock %}{% endset %}
      {% set mobile_buttons %}{% block mobile_actions %}{% endblock %}{% endset %}
      {% set has_desktop_buttons = desktop_buttons|striptags|trim is not empty %}
      {% set has_mobile_buttons = mobile_buttons|striptags|trim is not empty %}
      <div class="sfa-event-hero__actions{% if has_mobile_buttons %} sfa-event-hero__actions--desktop{% endif %}{% if not has_desktop_buttons %} sfa-event-hero__actions--empty{% endif %}">
        {{ desktop_buttons }}
      </div>
      <div class="sfa-event-hero__actions sfa-event-hero__actions--mobile{% if not has_mobile_buttons %} sfa-event-hero__actions--empty{% endif %}">
        {{ mobile_buttons }}
      </div>
    </div>
  </div>
</section>
