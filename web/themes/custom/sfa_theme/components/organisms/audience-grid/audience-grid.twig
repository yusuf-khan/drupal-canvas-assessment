{% if anchor %}{% set attributes = attributes.setAttribute('id', anchor|clean_id) %}{% endif %}
<div {{ attributes.addClass('sfa-audience-grid', 'sfa-surface--' ~ background|default('white')) }}>
  <div class="sfa-container">
    {# Preserve the section intro on saved groups pending migration. #}
    {% if summary or formatted_heading or formatted_summary %}
      <div class="sfa-audience-grid__intro">
        {% include 'sfa_theme:title' with {formatted: formatted_heading|default('')} only %}
        {% include 'sfa_theme:prose' with {text: summary|default(''), formatted: formatted_summary|default('')} only %}
      </div>
    {% endif %}
    <div class="sfa-audience-grid__items sfa-audience-grid__items--{{ columns|default('four') }}">
      {% block cards %}{% endblock %}
    </div>
  </div>
</div>
